---
/**
 * Tibana et al. 2018, n = 9. Heart rate and blood lactate are different
 * measures on different scales, so they get two panels rather than two y-axes.
 *
 * Both panels are drawn from zero on purpose. That is what makes the finding
 * legible: the heart-rate bars are the same height because heart rate did not
 * separate the two sessions, and truncating the axis to manufacture a visible
 * gap would invert the result.
 */
interface Series {
  name: string;
  token: string;
  hr: number;
  hrSd: number;
  lactate: number;
  lactateSd: number;
}

const series: Series[] = [
  {
    name: '~4 min',
    token: 'var(--color-chart-1)',
    hr: 176,
    hrSd: 6,
    lactate: 15.9,
    lactateSd: 2.2,
  },
  {
    name: '~17 min',
    token: 'var(--color-chart-2)',
    hr: 174,
    hrSd: 3,
    lactate: 12.6,
    lactateSd: 2.6,
  },
];

const PANEL_W = 260;
const GAP = 60;
const PLOT_H = 150;
const TOP = 34;
const BASE = TOP + PLOT_H;
const HEIGHT = BASE + 46;
const BAR_W = 62;
const SLOT = PANEL_W / series.length;
const R = 4;
const WIDTH = PANEL_W * 2 + GAP;

const panels = [
  {
    title: 'Peak heart rate',
    unit: 'bpm',
    max: 200,
    x: 0,
    value: (s: Series) => s.hr,
    sd: (s: Series) => s.hrSd,
    format: (v: number) => String(v),
    verdict: 'Not significant (p = 0.387)',
  },
  {
    title: 'Blood lactate in recovery',
    unit: 'mmol/L',
    max: 20,
    x: PANEL_W + GAP,
    value: (s: Series) => s.lactate,
    sd: (s: Series) => s.lactateSd,
    format: (v: number) => v.toFixed(1),
    verdict: 'Significant (p = 0.019)',
  },
];

function bar(x: number, y: number, w: number, h: number): string {
  const r = Math.min(R, h);
  return `M ${x} ${y + h} V ${y + r} a ${r} ${r} 0 0 1 ${r} ${-r} H ${x + w - r} a ${r} ${r} 0 0 1 ${r} ${r} V ${y + h} Z`;
}
---

<figure class="my-8 space-y-4">
  <figcaption class="space-y-1">
    <p class="text-display text-lg text-ink">
      Heart rate did not separate the two sessions. Lactate did.
    </p>
    <p class="text-sm text-secondary">
      Nine trained men, each completing a short and a long session. Bars are means; the whiskers are
      one standard deviation.
    </p>
  </figcaption>

  <svg
    viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
    class="h-auto w-full"
    role="img"
    aria-label="Peak heart rate 176 plus or minus 6 bpm after the short session and 174 plus or minus 3 after the long one, not significant. Blood lactate 15.9 plus or minus 2.2 and 12.6 plus or minus 2.6 millimoles per litre, significant."
  >
    {
      panels.map((panel) => (
        <g>
          <text x={panel.x} y="12" class="fill-ink" style="font-size:13px;font-weight:600">
            {panel.title}
          </text>
          <text x={panel.x} y="28" class="fill-secondary" style="font-size:11px">
            {panel.unit} · {panel.verdict}
          </text>
          <line
            x1={panel.x}
            y1={BASE}
            x2={panel.x + PANEL_W}
            y2={BASE}
            stroke="var(--color-border)"
            stroke-width="1"
          />
          {series.map((entry, index) => {
            const value = panel.value(entry);
            const sd = panel.sd(entry);
            const h = (value / panel.max) * PLOT_H;
            const x = panel.x + index * SLOT + (SLOT - BAR_W) / 2;
            const mid = x + BAR_W / 2;
            const hi = BASE - ((value + sd) / panel.max) * PLOT_H;
            const lo = BASE - ((value - sd) / panel.max) * PLOT_H;
            return (
              <g>
                <path d={bar(x, BASE - h, BAR_W, h)} fill={entry.token}>
                  <title>{`${entry.name}: ${panel.format(value)} ± ${panel.format(sd)} ${panel.unit}`}</title>
                </path>
                <g stroke="var(--color-ink)" stroke-width="1.5" opacity="0.55">
                  <line x1={mid} y1={hi} x2={mid} y2={lo} />
                  <line x1={mid - 8} y1={hi} x2={mid + 8} y2={hi} />
                  <line x1={mid - 8} y1={lo} x2={mid + 8} y2={lo} />
                </g>
                <text
                  x={mid}
                  y={hi - 8}
                  text-anchor="middle"
                  class="fill-ink"
                  style="font-size:13px;font-weight:600"
                >
                  {panel.format(value)}
                </text>
                <text
                  x={mid}
                  y={BASE + 20}
                  text-anchor="middle"
                  class="fill-secondary"
                  style="font-size:12px"
                >
                  {entry.name}
                </text>
              </g>
            );
          })}
        </g>
      ))
    }
    <g>
      {
        series.map((entry, index) => (
          <g>
            <rect x={index * 110} y={HEIGHT - 12} width="9" height="9" rx="2" fill={entry.token} />
            <text x={index * 110 + 14} y={HEIGHT - 4} class="fill-secondary" style="font-size:12px">
              {entry.name} session
            </text>
          </g>
        ))
      }
    </g>
  </svg>
</figure>
