---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — AMRAP With Friends" description="">
  <div class="mx-auto w-full max-w-[36rem] space-y-6 px-6 py-20 text-center lg:px-10">
    <h1 class="text-display text-[clamp(2.5rem,7vw,4rem)] leading-[0.9] text-ink">
      Page not found
    </h1>
    <p class="text-base leading-[1.7] text-secondary">
      That link does not point anywhere. A rally point closes once its mission is done, so an old
      rally link will land here too.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        class="rounded-card bg-accent px-6 py-3.5 font-semibold text-on-accent hover:bg-accent-hover"
        href="/">Back to the home page</a
      >
      <a
        class="rounded-card border border-border bg-surface px-6 py-3.5 font-semibold text-ink"
        href="/amrap-workouts">Browse AMRAP workouts</a
      >
    </div>
  </div>
</BaseLayout>
