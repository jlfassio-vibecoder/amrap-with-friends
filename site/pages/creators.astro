---
/**
 * Recruiting landing for coaches and creators.
 * Interactive widgets live in site/islands/creators/; styles in site/styles/creators.css.
 * SEO: src/lib/seo/routes.ts `/creators`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterRail from '../islands/creators/ChapterRail';
import HostingSteps from '../islands/creators/HostingSteps';
import HostingWeekTabs from '../islands/creators/HostingWeekTabs';
import MissionRoomPreview from '../islands/creators/MissionRoomPreview';
import RevenueEstimator from '../islands/creators/RevenueEstimator';
import { breadcrumbList, faqPage } from '@/lib/seo/structuredData';
import '../styles/creators.css';

const APPLY_URL = 'https://www.amrapwithfriends.com/apply';

const faqs = [
  {
    question: 'Do my followers need to pay to join my room?',
    answer:
      'No. Joining is free, forever, no account needed. You earn when someone chooses to subscribe for history, all the leaderboards, AMQAP recovery flows, and clean share cards. Most people who pay do it after a few weeks in your room.',
  },
  {
    question: 'What if someone joins my room but signed up through another coach?',
    answer:
      "Athletes choose one home coach and can change it once every 90 days. If they already have one, they stay attributed to that coach even in your room. The dashboard shows you exactly who's yours.",
  },
  {
    question: 'What does "net revenue" mean?',
    answer:
      "List price minus any discount the athlete used, card processing fees, refunds, and sales tax. On a $69.99 annual plan with the squad discount that's about $57. At Builder you'd earn about $17 on that sale, and about $9 when it renews.",
  },
  {
    question: 'Do I have to disclose that I earn from this?',
    answer:
      "Yes, and we make it easy. The launch kit includes the disclosure line, and the program terms require it. It's the same as any affiliate relationship.",
  },
  {
    question: 'Can I keep my Zoom or my Live?',
    answer:
      'Yes. The room is just the clock and the board. Run it alongside whatever you already do. Plenty of hosts run the room on a laptop and go live from their phone.',
  },
  {
    question: 'What if I have a gym, not a following?',
    answer:
      'There\'s a gym tier coming with a TV clock and member rosters. Apply anyway and say "gym" in the channel field; the first pilots are free.',
  },
];

const jsonLd = [
  faqPage(faqs),
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Creators', path: '/creators' },
  ]),
];
---

<BaseLayout jsonLd={jsonLd} hideHeader hideBack>
  <div class="creators">
    <header class="creators-top">
      <a class="creators-wordmark" href="/">AMRAP With Friends</a>
      <a class="creators-btn creators-btn-small" href="#apply">Apply to host</a>
    </header>

    <section class="creators-hero" id="top">
      <div class="creators-hero-copy">
        <h1>Your followers already train alone. Give them a room.</h1>
        <p class="creators-lede">
          Host one live AMRAP a week. Everyone joins from a link, the clock syncs, rounds count on
          one board. You earn a share of every subscription your squad buys, and every finish
          becomes a post with your handle on it.
        </p>
        <div class="creators-hero-actions">
          <a class="creators-btn" href="#apply">Apply to host</a>
          <a class="creators-link" href="#estimate">See what a squad is worth</a>
        </div>
        <p class="creators-fine">
          Free coach account for founding hosts. No follower minimum. Payouts monthly.
        </p>
      </div>
      <MissionRoomPreview client:visible />
    </section>

    <ChapterRail client:visible />

    <section class="creators-chapter" id="what">
      <h2>What you're actually hosting</h2>
      <p class="creators-lede">
        A mission is a workout with a synced clock. You pick the workout, share one link, and start
        it. Nobody installs anything. Nobody makes an account to play.
      </p>
      <HostingSteps client:visible />
    </section>

    <section class="creators-chapter" id="socials">
      <h2>Every finish is a post that tags you</h2>
      <p class="creators-lede">
        When the clock hits zero, each athlete gets a share card and a 20-second replay of the race,
        made on their phone, with your handle and your link on it. You don't ask them to post. The
        card is worth posting.
      </p>
      <div class="creators-cards-row">
        <figure class="creators-sharecard">
          <figcaption>Maya's card</figcaption>
          <div class="creators-sc">
            <span class="creators-sc-top">12 min AMRAP</span>
            <span class="creators-sc-score">7<small>+12</small></span>
            <span class="creators-sc-name">Maya</span>
            <ol class="creators-sc-board">
              <li>Deshawn 8+3</li>
              <li>Maya 7+12</li>
              <li>Priya 7+4</li>
            </ol>
            <span class="creators-sc-host">Trained with @yourhandle</span>
            <span class="creators-sc-link">amrapwithfriends.com/s/k4d2q9</span>
          </div>
        </figure>
        <ul class="creators-proof">
          <li>
            <b>A weekly ritual</b>
            gives your feed a fixed appointment. "Tuesday, 6pm, my room" is a hook you can repeat for
            a year.
          </li>
          <li>
            <b>Their audience sees your handle</b>
            on a card they made about themselves. It's a referral that doesn't feel like one.
          </li>
          <li>
            <b>The link unfurls with the card</b>
            in DMs, group chats and Slack. Anyone who taps it lands on your room.
          </li>
          <li>
            <b>Your squad board is content.</b>
            Post the top five every week. The age-adjusted and weight-adjusted boards give your older
            and lighter athletes a reason to share too.
          </li>
        </ul>
      </div>
    </section>

    <section class="creators-chapter" id="estimate">
      <h2>What a squad is worth to you</h2>
      <p class="creators-lede">
        Move the sliders to your numbers. This uses the program's real rates and conservative
        conversion assumptions; it's an estimate, not a promise.
      </p>
      <RevenueEstimator client:visible />
    </section>

    <section class="creators-chapter" id="week">
      <h2>What a hosting week looks like</h2>
      <p class="creators-lede">About ninety minutes, most of it the workout itself.</p>
      <HostingWeekTabs client:visible />
    </section>

    <section class="creators-chapter" id="apply">
      <h2>Apply to host</h2>
      <p class="creators-lede">
        We're taking 20 founding hosts for the first 90 days. Tell us where your people train with
        you and when you'd run your room.
      </p>
      <form class="creators-apply" action={APPLY_URL} method="post">
        <label>
          <span class="creators-lbl">Name</span>
          <input name="name" required autocomplete="name" />
        </label>
        <label>
          <span class="creators-lbl">Email</span>
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <label>
          <span class="creators-lbl">Main handle (Instagram, TikTok, YouTube…)</span>
          <input name="handle" placeholder="@" required />
        </label>
        <label>
          <span class="creators-lbl">Where do you run group workouts today?</span>
          <select name="channel" required>
            <option value="">Choose one</option>
            <option>Instagram Live</option>
            <option>Zoom / Google Meet</option>
            <option>Discord or WhatsApp group</option>
            <option>In-person class or run club</option>
            <option>I don't yet, I want to start</option>
          </select>
        </label>
        <label>
          <span class="creators-lbl">Day and time you'd host</span>
          <input name="slot" placeholder="Tuesdays 6pm PT" />
        </label>
        <button class="creators-btn" type="submit">Send application</button>
        <p class="creators-fine">
          We reply within 3 days. If it's a fit, we'll book your setup call on that email.
        </p>
      </form>

      <div class="creators-faq">
        {
          faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <footer class="creators-foot">
      <span>AMRAP With Friends</span>
      <a href="/terms">Program terms</a>
      <a href="/">Home</a>
    </footer>
  </div>
</BaseLayout>
