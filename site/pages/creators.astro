---
/**
 * Recruiting landing for coaches and creators.
 * Interactive widgets live in site/islands/creators/; styles in site/styles/creators.css.
 * SEO: src/lib/seo/routes.ts `/creators`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterRail from '../islands/creators/ChapterRail';
import EstimatorsTabs from '../islands/creators/EstimatorsTabs';
import HostingSteps from '../islands/creators/HostingSteps';
import HostingWeekTabs from '../islands/creators/HostingWeekTabs';
import MissionRoomPreview from '../islands/creators/MissionRoomPreview';
import RevenueTiers from '../islands/creators/RevenueTiers';
import { breadcrumbList, faqPage } from '@/lib/seo/structuredData';
import '../styles/creators.css';

const faqs = [
  {
    question: 'Do athletes need to pay or make an account to join?',
    answer:
      'No. Joining a mission is free and guests can play without an account. Saving a result and joining a coach group are optional. Neither should block participation.',
  },
  {
    question: 'Who gets credit for a subscription?',
    answer:
      'Under the proposed pilot policy, coach-group membership and commission attribution are separate. Athletes may train with multiple coaches. An eligible referral lasts 60 days; the latest eligible referral is shown at checkout and can be corrected before payment. The credited coach is fixed on the subscription at its first paid conversion. Later group changes do not transfer past or renewal commissions. Purchases without an eligible referral earn no commission.',
  },
  {
    question: 'What does net revenue mean?',
    answer:
      'Revenue after discounts, processing fees, refunds and sales tax. At the proposed Builder rate, a $69.99 annual plan with a 15% first-purchase discount yields about $57.46 net and $17.24 commission. An undiscounted $69.99 renewal yields about $67.66 net and $10.15 at 15%. These examples assume illustrative processing fees and no tax or refund; actual amounts vary.',
  },
  {
    question: 'What is a 6-month subscriber worth?',
    answer:
      'The proposed rate is 30% of net for a subscriber’s first 12 months and 15% after that — and a 6-month plan bills twice inside that first year, so both of those terms would pay at 30%. On the proposed $44.99 plan: about $36.83 net and $11.05 on the discounted first term, about $43.39 net and $13.02 on the second, then about $6.51 on each term from month 13. That is roughly $24.07 in year one against $17.24 for an annual subscriber, because someone on a 6-month plan pays more across a year than someone on the annual plan, which carries a larger discount. Illustrative processing fees, no tax or refund; actual amounts vary.',
  },
  {
    question: 'Should I steer athletes toward one plan?',
    answer:
      'No, and we would rather say why than leave you to work it out. Under the proposed rates a 6-month subscriber earns you more — about $24.07 in year one and $13.02 a year after, against $17.24 and $10.15 on the annual plan. The annual plan is steadier, because it asks the athlete to decide once a year instead of twice. Let athletes pick the plan that suits them; both are worth having.',
  },
  {
    question: 'When would payouts arrive?',
    answer:
      'Proposed payouts are through Stripe on the 15th, after a 30-day transaction hold, with a $25 minimum. Smaller balances roll forward. Payout onboarding and final written terms must be ready before paid referrals begin. Applying does not activate payouts.',
  },
  {
    question: 'How should I disclose a paid referral?',
    answer:
      'Before paid referrals begin, we will provide disclosure wording with the written program terms. Planned wording: “I earn a share if you subscribe through my referral.” Make that relationship clear wherever you promote a paid referral.',
  },
  {
    question: 'Can I keep my Zoom or my Live?',
    answer:
      'Yes. Use the mission clock and scoreboard alongside your usual video or group channel. There is no need to replace your existing coaching workflow.',
  },
  {
    question: 'What if I run a gym?',
    answer:
      'Choose Gym / fitness studio in the application. TV mode and member rosters are a separate planned gym pilot, with three locations and a proposed 90-day free trial. Applying does not guarantee a place or immediate access to those features.',
  },
];

const jsonLd = [
  faqPage(faqs),
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Creators', path: '/creators' },
  ]),
];
---

<BaseLayout jsonLd={jsonLd} hideHeader hideBack>
  <div class="creators">
    <header class="creators-top">
      <a class="creators-wordmark" href="/">AMRAP With Friends</a>
      <a class="creators-btn creators-btn-small" href="#apply">Apply to host</a>
    </header>

    <section class="creators-hero" id="top">
      <div class="creators-hero-copy">
        <p class="creators-eyebrow">Founding Host pilot invitation</p>
        <h1>Turn your followers into a squad that trains together.</h1>
        <p class="creators-lede">
          Host one or more live AMRAP missions a week. Athletes join your branded room from a link,
          train on the same clock, and log rounds together. Help us learn what brings your squad
          back for a second mission. We are starting with 3–5 pilot hosts, then expanding toward 20
          as the pilot proves useful.
        </p>
        <div class="creators-hero-actions">
          <a class="creators-btn" href="#apply">Apply to host</a>
          <a class="creators-link" href="#estimate">See proposed pilot benefits</a>
        </div>
        <p class="creators-fine">
          Applications are open for the pilot. No follower minimum. Selection is based on your
          ability to host a regular group.
        </p>
      </div>
      <MissionRoomPreview client:load />
    </section>

    <ChapterRail client:visible />

    <section class="creators-chapter" id="what">
      <h2>What you're actually hosting</h2>
      <p class="creators-lede">
        A mission is a workout with a synced clock. You pick the workout, share one link, and start
        it. Nobody installs anything. Nobody makes an account to play.
      </p>
      <HostingSteps client:visible />
    </section>

    <section class="creators-chapter" id="socials">
      <h2>Every finish creates something worth sharing</h2>
      <p class="creators-lede">
        Athletes can choose to share a result card and make an optional replay on supported devices.
        Sharing is never required. Coach-branded cards, personal handle links and referral tracking
        are planned pilot benefits, not promises of immediate access.
      </p>
      <div class="creators-cards-row">
        <figure class="creators-sharecard">
          <figcaption>
            Illustrative card — coach branding is planned; names are fictional
          </figcaption>
          <div class="creators-sc">
            <span class="creators-sc-top">12 min AMRAP</span>
            <span class="creators-sc-score">7<small>+12</small></span>
            <span class="creators-sc-name">Maya</span>
            <ol class="creators-sc-board">
              <li>Deshawn 8+3</li>
              <li>Maya 7+12</li>
              <li>Priya 7+4</li>
            </ol>
            <span class="creators-sc-host">Trained with @yourhandle</span>
            <span class="creators-sc-link">amrapwithfriends.com/s/k4d2q9</span>
          </div>
        </figure>
        <ul class="creators-proof">
          <li>
            <b>A weekly ritual</b>
            gives your feed a fixed appointment. "Tuesday, 6pm, my room" is a hook you can repeat to attract
            new followers and paying clients.
          </li>
          <li>
            <b>Their audience sees your handle</b>
            on a card they made about themselves. It's a referral that doesn't feel like one.
          </li>
          <li>
            <b>The link unfurls with the card</b>
            in DMs, group chats and Slack. Anyone who taps it lands on your room.
          </li>
          <li>
            <b>Your room board is content.</b>
            Post the top five every week. The age-adjusted and weight-adjusted boards give your older
            and lighter athletes a reason to share too.
          </li>
        </ul>
      </div>
    </section>

    <section class="creators-chapter" id="growth">
      <h2>Grow your socials footprint</h2>
      <p class="creators-lede">
        Host alongside a Live and every finish card that tags you becomes a post in someone else's
        feed. Views turn into follows. This is a conservative picture of the loop, not a promise.
      </p>
      <p>
        One weekly room compounds: athletes who finish share the card, their followers see your
        handle, and a few of those taps become people who show up next Tuesday. The loop is slow and
        repeatable — not a viral spike — which is why we describe it conservatively and without
        forecasting follower counts.
      </p>
    </section>

    <section class="creators-chapter" id="estimate">
      <h2>Your share grows with your room</h2>
      <RevenueTiers client:visible />
    </section>

    <section class="creators-chapter" id="week">
      <h2>What a hosting week looks like</h2>
      <p class="creators-lede">About ninety minutes, most of it the workout itself.</p>
      <HostingWeekTabs client:visible />
    </section>

    <section class="creators-chapter" id="apply">
      <h2>Apply to host</h2>
      <p class="creators-lede">
        We are selecting 3–5 hosts first, then expanding toward 20 after reviewing repeat
        participation. Tell us where your group trains and when you would host a weekly mission.
      </p>
      <form
        class="creators-apply"
        action="mailto:hello@amrapwithfriends.com"
        method="get"
        id="pilot-application"
      >
        <label>
          <span class="creators-lbl">Name</span>
          <input name="name" required autocomplete="name" />
        </label>
        <label>
          <span class="creators-lbl">Email</span>
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <label>
          <span class="creators-lbl">Main handle or gym name</span>
          <input name="handle" placeholder="@handle or gym name" required />
        </label>
        <label>
          <span class="creators-lbl">Where do you run group workouts today?</span>
          <select name="channel" required>
            <option value="">Choose one</option>
            <option>Instagram Live</option>
            <option>Zoom / Google Meet</option>
            <option>Discord or WhatsApp group</option>
            <option>In-person class or run club</option>
            <option>Gym / fitness studio</option>
            <option>I don't yet, I want to start</option>
          </select>
        </label>
        <label>
          <span class="creators-lbl">Day and time you'd host</span>
          <input name="slot" placeholder="Tuesdays 6pm PT" />
        </label>
        <button class="creators-btn" type="submit">Open email application</button>
        <p class="creators-fine">
          This opens a draft in your email app; review and send it there. Nothing is submitted until
          you send. If it does not open, email hello@amrapwithfriends.com with the details above.
        </p>
      </form>

      <div class="creators-faq">
        {
          faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="creators-chapter" id="pilot-details">
      <h2>Pilot details — proposed, not final program terms</h2>
      <p>
        Applying expresses interest and does not enroll you in a paid program. We will confirm
        available tools, the free-access start date, commission eligibility, tier changes, refunds,
        resubscriptions and payout setup in writing before paid referrals begin.
      </p>
      <p>
        The proposed Founding Host offer is 12 months of Coach access at no charge; the planned
        standard annual price is $199.99. We ask accepted hosts to run one public mission per week
        for eight weeks and share their own finish, respecting other athletes’ privacy.
      </p>
      <p>
        Coach groups are optional and can be left without transferring existing subscription
        commissions. Eligible referral touches last 60 days; checkout identifies the credited coach.
        Self-referrals are excluded; shared devices or payment methods require review rather than
        automatic rejection. A dispute process will be included in the written terms.
      </p>
      <p>
        The proposed athlete offer is a 14-day trial and 15% off the first eligible 6- or 12-month
        plan. It does not stack with founding pricing; checkout will show the eligible price and
        renewal terms. Features and offers described as planned require confirmation before use.
      </p>
      <p>
        Our <a href="/terms">general Terms of Use</a> cover use of the app. They are not creator commission
        terms. See our <a href="/privacy">Privacy policy</a> for data handling.
      </p>
    </section>

    <section class="creators-chapter" id="estimates">
      <h2>Run the numbers</h2>
      <p class="creators-lede">
        Conservative estimates from the same models as the original creators page — not a promise.
        Move the sliders to your numbers.
      </p>
      {
        /* Copilot suggestion ignored: estimators were intentionally restored at page bottom after the pilot rewrite. */
      }
      <EstimatorsTabs client:visible />
    </section>

    <footer class="creators-foot">
      <span>AMRAP With Friends</span>
      <a href="#pilot-details">Proposed pilot details</a>
      <a href="/">Home</a>
    </footer>
  </div>
</BaseLayout>

<script>
  import { sendContentEvent } from '@/lib/analytics/contentBeacon';

  const form = document.querySelector<HTMLFormElement>('#pilot-application');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '');
    const email = String(data.get('email') ?? '');
    const handle = String(data.get('handle') ?? '');
    const channel = String(data.get('channel') ?? '');
    const slot = String(data.get('slot') ?? '');

    // Copilot suggestion ignored: PII in analytics is intentional for the coach applications inbox (no CRM table in this PR).
    // Duplicate of the mailto draft for the /coach applications panel.
    sendContentEvent('founding_host_applied', { name, email, handle, channel, slot });

    const body = [
      `Name: ${name}`,
      `Email: ${email}`,
      `Handle or gym: ${handle}`,
      `Current group: ${channel}`,
      `Hosting time: ${slot}`,
    ].join('\n');
    // Copilot suggestion ignored: sendContentEvent already posts with keepalive: true for unload-safe delivery.
    window.location.href = `mailto:hello@amrapwithfriends.com?subject=${encodeURIComponent('Founding Host pilot application')}&body=${encodeURIComponent(body)}`;
  });
</script>
