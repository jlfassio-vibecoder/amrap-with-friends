---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbList } from '@/lib/seo/structuredData';

// DRAFT — describes what the app actually stores today, accurately, but it has
// not been through legal review. See docs/epics/seo-roadmap.md, Phase 1.
const jsonLd = [
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Privacy', path: '/privacy' },
  ]),
];
---

<BaseLayout jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-[42rem] space-y-10 px-6 py-12 lg:px-10 lg:py-16">
    <header class="space-y-4">
      <h1 class="text-display text-[clamp(2.5rem,7vw,4rem)] leading-[0.9] text-ink">Privacy</h1>
      <p class="text-base leading-[1.7] text-secondary">
        What AMRAP With Friends stores, why it stores it, and how to have it removed.
      </p>
    </header>

    <section class="space-y-4">
      <h2 class="text-display text-2xl text-ink">What we store</h2>
      <ul class="space-y-3 text-base leading-[1.7] text-secondary">
        <li>
          <strong class="font-semibold text-ink">Your account.</strong> If you sign in, we store the email
          address you signed in with, so we can recognise you next time.
        </li>
        <li>
          <strong class="font-semibold text-ink">Your athlete profile.</strong> The details you enter
          yourself — your name, and the body metrics used to scale workouts and calculate scores. You
          choose what to enter and can change it at any time.
        </li>
        <li>
          <strong class="font-semibold text-ink">Your training record.</strong> The missions you run,
          the rounds you log, and the scores calculated from them.
        </li>
        <li>
          <strong class="font-semibold text-ink">Product usage events.</strong> Which screens get used
          and which actions get taken, so we can tell what is working. These are tied to a random identifier
          stored in your browser, and to your account if you are signed in.
        </li>
      </ul>
    </section>

    <section class="space-y-4">
      <h2 class="text-display text-2xl text-ink">What your browser stores</h2>
      <p class="text-base leading-[1.7] text-secondary">
        A small amount of data stays on your device rather than on our servers: your sign-in
        session, your light or dark theme preference, a random identifier used to group your usage
        events, and a token that lets you rejoin a mission you have already joined. Clearing your
        browser data removes all of it.
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="text-display text-2xl text-ink">Who else sees it</h2>
      <p class="text-base leading-[1.7] text-secondary">
        Other athletes in a mission you join can see the name on your profile and your score on the
        leaderboard — that is what a shared leaderboard is. Beyond that, we do not sell your data
        and we do not share it with advertisers. Our hosting and database providers process it on
        our behalf in order to run the service.
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="text-display text-2xl text-ink">Deleting your data</h2>
      <p class="text-base leading-[1.7] text-secondary">
        Email
        <a class="link-accent" href="mailto:privacy@amrapwithfriends.com"
          >privacy@amrapwithfriends.com</a
        >
        from the address on your account and we will delete your account and the records attached to it.
      </p>
    </section>
  </div>
</BaseLayout>
