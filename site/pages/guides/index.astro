---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbList } from '@/lib/seo/structuredData';
import { CONTENT_ROUTES } from '@/lib/seo/routes';

// Straight from the route table, so a new guide appears here by existing.
const guides = CONTENT_ROUTES.filter((route) => route.path.startsWith('/guides/') && route.index);

const jsonLd = [
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Guides', path: '/guides' },
  ]),
];
---

<BaseLayout jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-[46rem] space-y-12 px-6 py-12 lg:px-10 lg:py-16">
    <header class="space-y-4">
      <p class="eyebrow text-accent">Guides</p>
      <h1 class="text-display text-[clamp(2.5rem,7vw,4rem)] leading-[0.9] text-ink">
        How AMRAP training actually works
      </h1>
      <p class="text-base leading-[1.7] text-secondary">
        Straight answers to the questions people ask about the format — what it means, how to score
        it, how to pace it, and how to run one with other people.
      </p>
    </header>

    <ul class="space-y-4">
      {
        guides.map((guide) => (
          <li class="card p-5">
            <a class="text-display text-xl text-ink hover:text-accent" href={guide.path}>
              {guide.title.split(' — ')[0]}
            </a>
            <p class="mt-2 text-sm leading-[1.6] text-secondary">{guide.description}</p>
          </li>
        ))
      }
    </ul>

    <section class="space-y-4">
      <h2 class="text-display text-[clamp(1.75rem,4vw,2.5rem)] leading-[0.95] text-ink">
        Then go and do one
      </h2>
      <p class="text-base leading-[1.7] text-secondary">
        Reading about pacing is not pacing. The library has 150 bodyweight AMRAPs, and the free
        timer runs any of them.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          class="rounded-card bg-accent px-6 py-3.5 font-semibold text-on-accent hover:bg-accent-hover"
          href="/amrap-workouts">Browse AMRAP workouts</a
        >
        <a
          class="rounded-card border border-border bg-surface px-6 py-3.5 font-semibold text-ink"
          href="/amrap-timer">Free AMRAP timer</a
        >
      </div>
    </section>
  </div>
</BaseLayout>
