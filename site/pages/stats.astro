---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbList } from '@/lib/seo/structuredData';
import {
  categoryProfiles,
  durationProfiles,
  libraryTotals,
  movementFrequency,
} from '@/lib/seo/libraryStats';
import { categoryPath, durationPath } from '@/lib/seo/contentPages';
import type { WorkoutCategory } from '@/data/workoutTemplates';

const totals = libraryTotals();
const frequency = movementFrequency();
const top = frequency.slice(0, 15);
const durations = durationProfiles();
const categories = categoryProfiles();

const jsonLd = [
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'The data', path: '/stats' },
  ]),
];
---

<BaseLayout jsonLd={jsonLd}>
  <div class="mx-auto w-full max-w-[46rem] space-y-14 px-6 py-12 lg:px-10 lg:py-16">
    <header class="space-y-5">
      <p class="eyebrow text-accent">Original data</p>
      <h1 class="text-display text-[clamp(2.5rem,7vw,4rem)] leading-[0.9] text-ink">
        How {totals.workouts} AMRAP workouts are built
      </h1>
      <p class="border-l-2 border-accent pl-5 text-lg leading-[1.6] text-ink">
        Across {totals.workouts} bodyweight AMRAP workouts using {totals.movements} distinct movements,
        rounds get both longer and denser as the time cap grows — from {
          durations[0].averageMovements
        } movements and {durations[0].averageRepsPerRound} reps per round at {
          durations[0].durationMinutes
        } minutes, to {durations[durations.length - 1].averageMovements} movements and
        {durations[durations.length - 1].averageRepsPerRound} reps at {
          durations[durations.length - 1].durationMinutes
        } minutes.
      </p>
      <p class="text-sm text-muted">
        Computed from our own workout library at build time. Free to cite with a link.
      </p>
    </header>

    <section class="space-y-5">
      <h2 class="text-display text-[clamp(1.75rem,4vw,2.5rem)] leading-[0.95] text-ink">
        Round density by time cap
      </h2>
      <p class="text-base leading-[1.7] text-secondary">
        A longer cap does not just mean more rounds of the same thing. Programming for a 20-minute
        AMRAP means more movements per round and roughly double the reps of a 5-minute one, which is
        why the two feel like different sports.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-border">
              <th class="py-3 pr-4 font-semibold text-ink">Time cap</th>
              <th class="py-3 pr-4 font-semibold text-ink">Workouts</th>
              <th class="py-3 pr-4 font-semibold text-ink">Movements per round</th>
              <th class="py-3 font-semibold text-ink">Reps per round</th>
            </tr>
          </thead>
          <tbody class="text-secondary">
            {
              durations.map((profile) => (
                <tr class="border-b border-divider">
                  <td class="py-3 pr-4 font-semibold text-ink">
                    <a class="link-accent" href={durationPath(profile.durationMinutes)}>
                      {profile.durationMinutes} min
                    </a>
                  </td>
                  <td class="py-3 pr-4">{profile.workouts}</td>
                  <td class="py-3 pr-4">{profile.averageMovements}</td>
                  <td class="py-3">{profile.averageRepsPerRound}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="space-y-5">
      <h2 class="text-display text-[clamp(1.75rem,4vw,2.5rem)] leading-[0.95] text-ink">
        The most programmed movements
      </h2>
      <p class="text-base leading-[1.7] text-secondary">
        {top[0].name} appear in {top[0].share}% of workouts — more than any other movement. The top
        {top.length} account for the bulk of all programming, while {totals.singleUseMovements} movements
        appear in exactly one workout. The median movement is used in {
          totals.medianWorkoutsPerMovement
        }
        workouts.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[30rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-border">
              <th class="py-3 pr-4 font-semibold text-ink">Movement</th>
              <th class="py-3 pr-4 font-semibold text-ink">Workouts</th>
              <th class="py-3 font-semibold text-ink">Share</th>
            </tr>
          </thead>
          <tbody class="text-secondary">
            {
              top.map((entry) => (
                <tr class="border-b border-divider">
                  <td class="py-3 pr-4 font-semibold text-ink">
                    {entry.exerciseId ? (
                      <a class="link-accent" href={`/exercises/${entry.exerciseId}`}>
                        {entry.name}
                      </a>
                    ) : (
                      entry.name
                    )}
                  </td>
                  <td class="py-3 pr-4">{entry.workouts}</td>
                  <td class="py-3">{entry.share}%</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="space-y-5">
      <h2 class="text-display text-[clamp(1.75rem,4vw,2.5rem)] leading-[0.95] text-ink">
        Workouts by training stimulus
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[30rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-border">
              <th class="py-3 pr-4 font-semibold text-ink">Stimulus</th>
              <th class="py-3 pr-4 font-semibold text-ink">Workouts</th>
              <th class="py-3 font-semibold text-ink">Time caps</th>
            </tr>
          </thead>
          <tbody class="text-secondary">
            {
              categories.map((profile) => (
                <tr class="border-b border-divider">
                  <td class="py-3 pr-4 font-semibold text-ink">
                    <a class="link-accent" href={categoryPath(profile.id as WorkoutCategory)}>
                      {profile.label}
                    </a>
                  </td>
                  <td class="py-3 pr-4">{profile.workouts}</td>
                  <td class="py-3">{profile.durations.join(', ')} min</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-display text-[clamp(1.75rem,4vw,2.5rem)] leading-[0.95] text-ink">
        What is not here yet
      </h2>
      <p class="text-base leading-[1.7] text-secondary">
        Everything above describes how the workouts are built, not how people perform them. The
        athlete-side numbers — median rounds on a given workout, how round-time variance is
        distributed, how much a score typically improves across an eight-week campaign — need more
        recorded missions than we have. When there are enough for the numbers to be honest, they
        will be published here.
      </p>
      <p class="text-base leading-[1.7] text-secondary">
        In the meantime, <a class="link-accent" href="/guides/amrap-pacing">AMRAP pacing</a> explains
        the round-time variance measure itself, and
        <a class="link-accent" href="/guides/what-is-a-good-amrap-score">
          what is a good AMRAP score</a
        > explains why a published median would be less useful than you would expect.
      </p>
    </section>
  </div>
</BaseLayout>
