# =============================================================================
# AMRAP With Friends — environment variables
# =============================================================================
# Copy to .env and fill in values:
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Restart `npm run dev` after editing .env.
# =============================================================================

# --- Supabase (required for create/join lobby) ---
# Dashboard → Project Settings → API
# URL: Project URL (https://<project-ref>.supabase.co)
# Key: anon public or publishable key (NOT service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Auth UI (optional) ---
# Magic link is off unless this is true. Enable only after custom SMTP (e.g. Resend) is configured.
# VITE_AUTH_MAGIC_LINK_ENABLED=true
# Password reset is off unless this is true. Enable only after custom SMTP is configured,
# and add /reset-password to the Auth redirect allow-list.
# VITE_AUTH_PASSWORD_RESET_ENABLED=true
# Google OAuth is off unless this is true. Enable only after Google Cloud OAuth client +
# Supabase Auth → Providers → Google are configured, then redeploy so Vite bakes the flag.
# VITE_AUTH_GOOGLE_ENABLED=true

# --- Agora video (optional — not used until a later PR) ---
# VITE_AGORA_APP_ID=

# --- Supabase CLI / local tooling only (optional) ---
# Do NOT prefix with VITE_ — these must never ship to the browser.
# Used by: npm run seed:exercise-media
# SUPABASE_SERVICE_ROLE_KEY=
